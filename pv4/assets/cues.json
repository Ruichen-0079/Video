 "text": [
  {
   "id": 0,
   "style": "stamp",
   "t0": 0.8,
   "t1": 4.8,
   "text": "万花洲"
  },
  {
   "id": 1,
   "style": "line",
   "t0": 5.6,
   "t1": 7.3,
   "text": "你很美。",
   "who": "m"
  },
  {
   "id": 2,
   "style": "line",
   "t0": 7.6,
   "t1": 9.8,
   "text": "美貌也是有代价的。",
   "who": "f"
  },
  {
   "id": 3,
   "style": "stamp",
   "t0": 10.4,
   "t1": 16.8,
   "text": "亚人王朝"
  },
  {
   "id": 4,
   "style": "narr",
   "t0": 10.5,
   "t1": 13.3,
   "text": "很久以前，亚人统治着人间。"
  },
  {
   "id": 5,
   "style": "narr",
   "t0": 13.7,
   "t1": 16.8,
   "text": "人类，是他们的奴隶。"
  },
  {
   "id": 6,
   "style": "narr",
   "t0": 17.3,
   "t1": 21.3,
   "text": "亚人能凭想象显出兽的特征，也能把它藏起来。"
  },
  {
   "id": 7,
   "style": "stamp",
   "t0": 21.8,
   "t1": 27.8,
   "text": "末代亚人王朝"
  },
  {
   "id": 8,
   "style": "narr",
   "t0": 21.9,
   "t1": 24.8,
   "text": "末代的皇女子馥幽长得很慢，在宫中受人排挤。"
  },
  {
   "id": 9,
   "style": "narr",
   "t0": 25.1,
   "t1": 27.8,
   "text": "她看着姐姐出嫁。"
  },
  {
   "id": 10,
   "style": "narr",
   "t0": 28.9,
   "t1": 31.9,
   "text": "她年幼时，在海边遇见过一个老人。"
  },
  {
   "id": 11,
   "style": "narr",
   "t0": 32.2,
   "t1": 34.6,
   "text": "老人摸了摸她的头。"
  },
  {
   "id": 12,
   "style": "stamp",
   "t0": 35.3,
   "t1": 47.2,
   "text": "王朝覆灭"
  },
  {
   "id": 13,
   "style": "narr",
   "t0": 35.4,
   "t1": 39.3,
   "text": "那个老人，只是一个寿命普通的人类。"
  },
  {
   "id": 14,
   "style": "narr",
   "t0": 39.8,
   "t1": 43.3,
   "text": "他扶持人类的开国皇帝，"
  },
  {
   "id": 15,
   "style": "narr",
   "t0": 43.8,
   "t1": 47.3,
   "text": "推翻了末代亚人王朝。"
  },
  {
   "id": 16,
   "style": "narr",
   "t0": 47.8,
   "t1": 50.8,
   "text": "王朝覆灭后，一种草药的烟能逼亚人现出原形。"
  },
  {
   "id": 17,
   "style": "narr",
   "t0": 51,
   "t1": 53.8,
   "text": "人们用它狩猎残余的亚人。"
  },
  {
   "id": 18,
   "style": "narr",
   "t0": 54.3,
   "t1": 58.3,
   "text": "复国的人，把小皇女推到了旗下。"
  },
  {
   "id": 19,
   "style": "narr",
   "t0": 58.8,
   "t1": 62.8,
   "text": "她渐渐看清了旗子背后的交易。"
  },
  {
   "id": 20,
   "style": "narr",
   "t0": 63.3,
   "t1": 66.6,
   "text": "她出逃时，被复国的人砍伤。"
  },
  {
   "id": 21,
   "style": "narr",
   "t0": 67,
   "t1": 69.3,
   "text": "那道伤疤，一直没有消失。"
  },
  {
   "id": 22,
   "style": "narr",
   "t0": 69.7,
   "t1": 71.9,
   "text": "招式，本来并不存在。"
  },
  {
   "id": 23,
   "style": "narr",
   "t0": 72.1,
   "t1": 74.4,
   "text": "有人想出它，有人学会它，"
  },
  {
   "id": 24,
   "style": "narr",
   "t0": 74.6,
   "t1": 76.9,
   "text": "传得够久，它就成了真的。"
  },
  {
   "id": 25,
   "style": "stamp",
   "t0": 77.3,
   "t1": 83.3,
   "text": "周"
  },
  {
   "id": 26,
   "style": "narr",
   "t0": 77.3,
   "t1": 80.2,
   "text": "周朝。明布川年轻，刚刚登峰造极。"
  },
  {
   "id": 27,
   "style": "narr",
   "t0": 80.7,
   "t1": 83.3,
   "text": "他斩断了一个天才的左臂。"
  },
  {
   "id": 28,
   "style": "narr",
   "t0": 83.8,
   "t1": 87.4,
   "text": "那人以这道伤为根基，创立了负伤流派。"
  },
  {
   "id": 29,
   "style": "narr",
   "t0": 87.8,
   "t1": 89.8,
   "text": "后来，明布川清洗了这个流派。"
  },
  {
   "id": 30,
   "style": "narr",
   "t0": 90,
   "t1": 91.9,
   "text": "这是他一生的悔恨。"
  },
  {
   "id": 31,
   "style": "narr",
   "t0": 92.3,
   "t1": 94,
   "text": "那个老人的武学，是和妻子一起练成的，"
  },
  {
   "id": 32,
   "style": "narr",
   "t0": 94.2,
   "t1": 95.9,
   "text": "重在守护。"
  },
  {
   "id": 33,
   "style": "narr",
   "t0": 96.3,
   "t1": 97.7,
   "text": "妻子早逝。"
  },
  {
   "id": 34,
   "style": "narr",
   "t0": 97.9,
   "t1": 99.9,
   "text": "他追求的道，是放手。"
  },
  {
   "id": 35,
   "style": "narr",
   "t0": 100.4,
   "t1": 104.3,
   "text": "历代剑圣的背后，一直是同一个人。"
  },
  {
   "id": 36,
   "style": "stamp",
   "t0": 104.8,
   "t1": 111.8,
   "text": "夏"
  },
  {
   "id": 37,
   "style": "narr",
   "t0": 104.8,
   "t1": 106.8,
   "text": "明布川生在史书所称的夏朝。"
  },
  {
   "id": 38,
   "style": "narr",
   "t0": 107,
   "t1": 108.9,
   "text": "他不会老。"
  },
  {
   "id": 39,
   "style": "narr",
   "t0": 109.2,
   "t1": 111.9,
   "text": "他爱过的人老了，他被赶走了。"
  },
  {
   "id": 40,
   "style": "stamp",
   "t0": 112.3,
   "t1": 117.3,
   "text": "万花洲"
  },
  {
   "id": 41,
   "style": "narr",
   "t0": 112.3,
   "t1": 114.6,
   "text": "那个老人，为他们造了一个世界。"
  },
  {
   "id": 42,
   "style": "line",
   "t0": 114.8,
   "t1": 115.9,
   "text": "我叫明布川。",
   "who": "m"
  },
  {
   "id": 43,
   "style": "line",
   "t0": 116,
   "t1": 117.4,
   "text": "听起来像狗的名字。",
   "who": "f"
  },
  {
   "id": 44,
   "style": "stamp",
   "t0": 117.8,
   "t1": 125.3,
   "text": "黄泉"
  },
  {
   "id": 45,
   "style": "narr",
   "t0": 117.8,
   "t1": 121.4,
   "text": "为了一个因他而死的巫女，他闯了黄泉。"
  },
  {
   "id": 46,
   "style": "narr",
   "t0": 121.8,
   "t1": 124.9,
   "text": "然后，他沉睡了很久。"
  },
  {
   "id": 47,
   "style": "stamp",
   "t0": 125.7,
   "t1": 131.8,
   "text": "明"
  },
  {
   "id": 48,
   "style": "narr",
   "t0": 125.7,
   "t1": 128.7,
   "text": "明朝走向资本主义，工业渐渐盖过了武学。"
  },
  {
   "id": 49,
   "style": "narr",
   "t0": 128.9,
   "t1": 131.9,
   "text": "她一个人走过了许多朝代，以才女闻名，"
  },
  {
   "id": 50,
   "style": "narr",
   "t0": 132.1,
   "t1": 134.9,
   "text": "推动废除亚人奴隶制，"
  },
  {
   "id": 51,
   "style": "stamp",
   "t0": 135.1,
   "t1": 138.4,
   "text": "北美 · 独立战争"
  },
  {
   "id": 52,
   "style": "narr",
   "t0": 135.1,
   "t1": 138.4,
   "text": "在美国独立战争中担任军官。"
  },
  {
   "id": 53,
   "style": "narr",
   "t0": 138.8,
   "t1": 140.5,
   "text": "她一直在等他。"
  },
  {
   "id": 54,
   "style": "narr",
   "t0": 140.8,
   "t1": 142.8,
   "text": "他们在美国重逢。"
  },
  {
   "id": 55,
   "style": "stamp",
   "t0": 143.6,
   "t1": 148.3,
   "text": "现代"
  },
  {
   "id": 56,
   "style": "narr",
   "t0": 143.8,
   "t1": 145.9,
   "text": "「我从床上惊醒。四周空荡荡，什么也没有。」"
  },
  {
   "id": 57,
   "style": "narr",
   "t0": 146.1,
   "t1": 148.3,
   "text": "「望向写字桌上她留下的信纸，」"
  },
  {
   "id": 58,
   "style": "narr",
   "t0": 148.8,
   "t1": 152.1,
   "text": "她留下一封信，走了。"
  },
  {
   "id": 59,
   "style": "card1",
   "t0": 152.9,
   "t1": 159.7,
   "text": "她身上的那道伤疤，还没有消失。"
  },
  {
   "id": 60,
   "style": "card2",
   "t0": 154.7,
   "t1": 159.7,
   "text": "他还不知道，怎样与一个人长久地生活。"
  },
  {
   "id": 61,
   "style": "card3",
   "t0": 156.5,
   "t1": 159.7,
   "text": "她会去哪里，还没有写下。"
  }
 ]
}